<?xml version="1.0" encoding="UTF-8"?>
<project name="web-lab3" default="war" basedir=".">
    <property name="kotlin.home" value="kotlin-compiler/kotlinc"/>
    <property name="kotlin.ant.jar" value="${kotlin.home}/lib/kotlin-ant.jar"/>
    <property name="version" value="1.0"/>
    <property name="group" value="org.vaskozlov.lab3"/>
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build-ant"/>
    <property name="webapp.dir" value="${src.dir}/jvmMain/webapp"/>
    <property name="js.output.dir" value="${webapp.dir}/resources/js"/>
    <property name="css.dir" value="${webapp.dir}/resources/css"/>
    <property name="docs.dir" value="${build.dir}/docs"/>
    <property name="kdoc.dir" value="${docs.dir}/kdoc"/>

    <tstamp>
        <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tstamp>

    <!-- Path definitions -->
    <path id="compile.classpath">
        <!-- Jakarta/Java EE dependencies -->
        <fileset dir="lib">
            <include name="jakarta.faces-api-*.jar"/>
            <include name="jakarta.jakartaee-api-*.jar"/>
            <include name="jakarta.faces-*.jar"/>
            <include name="primefaces-*-jakarta.jar"/>
            <include name="postgresql-*.jar"/>
            <include name="kotlin-stdlib-*.jar"/>
            <include name="kotlinx-coroutines-core-*.jar"/>
            <include name="annotations-*.jar"/>
        </fileset>
    </path>

    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build.dir}/classes"/>
        <mkdir dir="${build.dir}/webapp"/>
        <mkdir dir="${js.output.dir}"/>
    </target>

    <!-- SCSS compilation targets -->
    <target name="compileCommonScss">
        <exec executable="sass">
            <arg value="${css.dir}/common.scss"/>
            <arg value="${css.dir}/common.css"/>
        </exec>
    </target>

    <target name="compileIndexScss">
        <exec executable="sass">
            <arg value="${css.dir}/index.scss"/>
            <arg value="${css.dir}/index.css"/>
        </exec>
    </target>

    <target name="compileMainScss">
        <exec executable="sass">
            <arg value="${css.dir}/main.scss"/>
            <arg value="${css.dir}/main.css"/>
        </exec>
    </target>

    <!-- TypeScript compilation -->
    <target name="compileTypeScript">
        <mkdir dir="${build.dir}/js/packages/web-lab3-js-main-page/kotlin"/>
        <exec executable="npx">
            <arg value="tsc"/>
            <arg value="--project"/>
            <arg value="tsconfig.json"/>
        </exec>
    </target>

    <!-- Note: The Kotlin Multiplatform JS compilation would need to be handled separately -->
    <!-- This is a placeholder - you would need to call the Kotlin compiler directly -->
    <target name="compileJsIntroPage">
        <echo message="This would compile the JS intro page using Kotlin/JS compiler"/>
        <!-- Actual implementation would require calling kotlinc-js -->
    </target>

    <target name="compileJsMainPage">
        <echo message="This would compile the JS main page using Kotlin/JS compiler"/>
        <!-- Actual implementation would require calling kotlinc-js -->
    </target>

    <!-- Compile JVM Kotlin code -->
    <target name="compileJvm" depends="init">
        <taskdef resource="org/jetbrains/kotlin/ant/antlib.xml"
                 classpath="${kotlin.ant.jar}"/>
        <!-- Compile Kotlin sources -->
        <kotlinc src="${src.dir}/jvmMain/kotlin"
                 output="${build.dir}/classes"
                 classpathref="compile.classpath">
            <!-- Include Java sources if any -->
            <src path="${src.dir}/jvmMain/java"/>
        </kotlinc>

        <!-- Copy resources -->
        <copy todir="${build.dir}/classes">
            <fileset dir="${src.dir}/jvmMain/resources" includes="**/*"/>
        </copy>
    </target>

    <path id="javadoc.classpath">
        <path refid="compile.classpath"/>
        <pathelement path="${build.dir}/classes"/>
    </path>

    <target name="doc" depends="compileJvm" description="Generates KDOC and adds checksums to MANIFEST">
        <!-- Create directories -->
        <mkdir dir="${kdoc.dir}"/>

        <!-- Generate KDOC using Kotlin compiler -->
        <exec executable="${kotlin.home}/bin/kotlinc" failonerror="true">
            <arg value="-d"/>
            <arg value="${kdoc.dir}"/>
            <arg value="-cp"/>
            <arg pathref="compile.classpath"/>
            <arg value="${src.dir}/jvmMain/kotlin"/>
        </exec>

        <!-- Generate MD5 and SHA1 checksums -->
        <checksum algorithm="MD5" fileext=".md5">
            <fileset dir="${src.dir}/jvmMain/kotlin" includes="**/*.kt"/>
        </checksum>

        <checksum algorithm="SHA-1" fileext=".sha1">
            <fileset dir="${src.dir}/jvmMain/kotlin" includes="**/*.kt"/>
        </checksum>

        <!-- Update JAR with new manifest and documentation -->
        <jar destfile="${build.dir}/${ant.project.name}.jar"
             basedir="${build.dir}/classes"
             update="true">

            <manifest>
                <attribute name="Main-Class" value="org.vaskozlov.lab3.MainKt"/>
                <attribute name="Implementation-Title" value="${ant.project.name}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Implementation-Vendor" value="${group}"/>
                <attribute name="Created-By" value="Apache Ant ${ant.version}"/>
                <attribute name="Built-By" value="${user.name}"/>
                <attribute name="Build-Date" value="${build.time}"/>

                <!-- Add checksums to MANIFEST -->
                <attribute name="Files-MD5" value="**/*.md5"/>
                <attribute name="Files-SHA1" value="**/*.sha1"/>
            </manifest>

            <!-- Add KDOC documentation to JAR -->
            <fileset dir="${kdoc.dir}" includes="**/*"/>

            <!-- Add checksum files to JAR -->
            <fileset dir="${src.dir}/jvmMain/kotlin">
                <include name="**/*.md5"/>
                <include name="**/*.sha1"/>
            </fileset>

            <zipgroupfileset dir="lib" includes="*.jar"/>
        </jar>
    </target>

    <!-- Modified jar target to depend on doc -->
    <target name="jar" depends="compileJvm, doc" description="Creates a JAR file with KDOC and checksums">
        <echo message="JAR file created with KDOC documentation and checksums"/>
    </target>

    <!-- Build WAR file -->
    <target name="war" depends="compileCommonScss, compileIndexScss, compileMainScss, compileTypeScript, compileJsIntroPage, compileJsMainPage, compileJvm">
        <war destfile="${build.dir}/${ant.project.name}.war" webxml="${webapp.dir}/WEB-INF/web.xml">
            <fileset dir="${webapp.dir}">
                <exclude name="WEB-INF/web.xml"/>
            </fileset>
            <classes dir="${build.dir}/classes"/>
            <lib dir="lib"/>
        </war>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>
</project>