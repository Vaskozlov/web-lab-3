<?xml version="1.0" encoding="UTF-8"?>
<project name="web-lab3" default="war" basedir=".">
    <property name="kotlin.home" value="kotlin-compiler/kotlinc"/>
    <property name="kotlin.ant.jar" value="${kotlin.home}/lib/kotlin-ant.jar"/>
    <property name="version" value="1.0"/>
    <property name="group" value="org.vaskozlov.lab3"/>
    <property name="src.dir" value="src"/>
    <property name="build.dir" value="build-ant"/>
    <property name="webapp.dir" value="${src.dir}/jvmMain/webapp"/>
    <property name="js.output.dir" value="${webapp.dir}/resources/js"/>
    <property name="css.dir" value="${webapp.dir}/resources/css"/>
    <property name="docs.dir" value="${build.dir}/docs"/>
    <property name="kdoc.dir" value="${docs.dir}/kdoc"/>

    <tstamp>
        <format property="build.time" pattern="yyyy-MM-dd HH:mm:ss"/>
    </tstamp>

    <!-- Path definitions -->
    <path id="compile.classpath">
        <!-- Jakarta/Java EE dependencies -->
        <fileset dir="lib">
            <include name="jakarta.faces-api-*.jar"/>
            <include name="jakarta.jakartaee-api-*.jar"/>
            <include name="jakarta.faces-*.jar"/>
            <include name="primefaces-*-jakarta.jar"/>
            <include name="postgresql-*.jar"/>
            <include name="kotlin-stdlib-*.jar"/>
            <include name="kotlinx-coroutines-core-*.jar"/>
            <include name="annotations-*.jar"/>

            <!-- JUnit and Kotlin test -->
            <include name="junit-*.jar"/>
            <include name="hamcrest-core-*.jar"/>
            <include name="kotlin-test-junit-*.jar"/>
            <include name="kotlin-test-*.jar"/>
        </fileset>
    </path>

    <target name="init">
        <mkdir dir="${build.dir}"/>
        <mkdir dir="${build.dir}/classes"/>
        <mkdir dir="${build.dir}/webapp"/>
        <mkdir dir="${js.output.dir}"/>
    </target>

    <!-- SCSS compilation targets -->
    <target name="compileCommonScss">
        <exec executable="sass">
            <arg value="${css.dir}/common.scss"/>
            <arg value="${css.dir}/common.css"/>
        </exec>
    </target>

    <target name="compileIndexScss">
        <exec executable="sass">
            <arg value="${css.dir}/index.scss"/>
            <arg value="${css.dir}/index.css"/>
        </exec>
    </target>

    <target name="compileMainScss">
        <exec executable="sass">
            <arg value="${css.dir}/main.scss"/>
            <arg value="${css.dir}/main.css"/>
        </exec>
    </target>

    <!-- TypeScript compilation -->
    <target name="compileTypeScript">
        <mkdir dir="${build.dir}/js/packages/web-lab3-js-main-page/kotlin"/>
        <exec executable="npx">
            <arg value="tsc"/>
            <arg value="--project"/>
            <arg value="tsconfig.json"/>
        </exec>
    </target>

    <!-- Note: The Kotlin Multiplatform JS compilation would need to be handled separately -->
    <!-- This is a placeholder - you would need to call the Kotlin compiler directly -->
    <target name="compileJsIntroPage">
        <echo message="This would compile the JS intro page using Kotlin/JS compiler"/>
        <!-- Actual implementation would require calling kotlinc-js -->
    </target>

    <target name="compileJsMainPage">
        <echo message="This would compile the JS main page using Kotlin/JS compiler"/>
        <!-- Actual implementation would require calling kotlinc-js -->
    </target>

    <!-- Compile JVM Kotlin code -->
    <target name="compileJvm" depends="init">
        <taskdef resource="org/jetbrains/kotlin/ant/antlib.xml"
                 classpath="${kotlin.ant.jar}"/>
        <!-- Compile Kotlin sources -->
        <kotlinc src="${src.dir}/jvmMain/kotlin"
                 output="${build.dir}/classes"
                 classpathref="compile.classpath">
            <!-- Include Java sources if any -->
            <src path="${src.dir}/jvmMain/java"/>
        </kotlinc>

        <!-- Copy resources -->
        <copy todir="${build.dir}/classes">
            <fileset dir="${src.dir}/jvmMain/resources" includes="**/*"/>
        </copy>
    </target>

    <target name="build" depends="compileJvm">

    </target>

    <path id="javadoc.classpath">
        <path refid="compile.classpath"/>
        <pathelement path="${build.dir}/classes"/>
    </path>

    <target name="doc" depends="compileJvm" description="Generates KDOC and adds checksums to MANIFEST">
        <!-- Create directories -->
        <mkdir dir="${kdoc.dir}"/>

        <!-- Generate KDOC using Kotlin compiler -->
        <exec executable="${kotlin.home}/bin/kotlinc" failonerror="true">
            <arg value="-d"/>
            <arg value="${kdoc.dir}"/>
            <arg value="-cp"/>
            <arg pathref="compile.classpath"/>
            <arg value="${src.dir}/jvmMain/kotlin"/>
        </exec>

        <!-- Generate MD5 and SHA1 checksums -->
        <checksum algorithm="MD5" fileext=".md5">
            <fileset dir="${src.dir}/jvmMain/kotlin" includes="**/*.kt"/>
        </checksum>

        <checksum algorithm="SHA-1" fileext=".sha1">
            <fileset dir="${src.dir}/jvmMain/kotlin" includes="**/*.kt"/>
        </checksum>

        <!-- Update JAR with new manifest and documentation -->
        <jar destfile="${build.dir}/${ant.project.name}.jar"
             basedir="${build.dir}/classes"
             update="true">

            <manifest>
                <attribute name="Main-Class" value="org.vaskozlov.lab3.MainKt"/>
                <attribute name="Implementation-Title" value="${ant.project.name}"/>
                <attribute name="Implementation-Version" value="${version}"/>
                <attribute name="Implementation-Vendor" value="${group}"/>
                <attribute name="Created-By" value="Apache Ant ${ant.version}"/>
                <attribute name="Built-By" value="${user.name}"/>
                <attribute name="Build-Date" value="${build.time}"/>

                <!-- Add checksums to MANIFEST -->
                <attribute name="Files-MD5" value="**/*.md5"/>
                <attribute name="Files-SHA1" value="**/*.sha1"/>
            </manifest>

            <!-- Add KDOC documentation to JAR -->
            <fileset dir="${kdoc.dir}" includes="**/*"/>

            <!-- Add checksum files to JAR -->
            <fileset dir="${src.dir}/jvmMain/kotlin">
                <include name="**/*.md5"/>
                <include name="**/*.sha1"/>
            </fileset>

            <zipgroupfileset dir="lib" includes="*.jar"/>
        </jar>
    </target>

    <!-- Modified jar target to depend on doc -->
    <target name="jar" depends="compileJvm, doc" description="Creates a JAR file with KDOC and checksums">
        <echo message="JAR file created with KDOC documentation and checksums"/>
    </target>

    <!-- Build WAR file -->
    <target name="war" depends="compileCommonScss, compileIndexScss, compileMainScss, compileTypeScript, compileJsIntroPage, compileJsMainPage, compileJvm">
        <war destfile="${build.dir}/${ant.project.name}.war" webxml="${webapp.dir}/WEB-INF/web.xml">
            <fileset dir="${webapp.dir}">
                <exclude name="WEB-INF/web.xml"/>
            </fileset>
            <classes dir="${build.dir}/classes"/>
            <lib dir="lib"/>
        </war>
    </target>

    <target name="clean">
        <delete dir="${build.dir}"/>
    </target>

    <target name="compile" depends="compileJvm"/>

    <target name="compileTests" depends="compileJvm">
        <kotlinc src="${src.dir}/jvmTest/kotlin"
                output="${build.dir}/classes-test"
                classpathref="compile.classpath"/>
    </target>

    <target name="test" depends="compileTests">
        <mkdir dir="${build.dir}/test-results"/>
        <junit printsummary="yes" haltonfailure="yes">
            <classpath>
                <path refid="compile.classpath"/>
                <pathelement path="${build.dir}/classes-test"/>
            </classpath>
            <formatter type="xml"/>
            <batchtest todir="${build.dir}/test-results">
                <fileset dir="${build.dir}/classes-test">
                    <include name="**/*Test.class"/>
                </fileset>
            </batchtest>
        </junit>
    </target>

    <target name="scp" depends="build">
        <input message="Enter SCP destination (e.g., user@host:/path):" addproperty="scp.dest"/>
        <input message="Enter password:" addproperty="scp.password"/>
        <exec executable="scp">
            <arg line="${build.dir}/${ant.project.name}.jar ${build.dir}/${ant.project.name}.war ${scp.dest}"/>
        </exec>
    </target>

    <target name="native2ascii">
        <mkdir dir="${build.dir}/native2ascii"/>
        <native2ascii 
            src="src/jvmMain/resources/localization"
            dest="${build.dir}/native2ascii"
            encoding="UTF-8"
            includes="*.properties"
        />
    </target>

    <target name="xml">
        <xmlvalidate lenient="true">
            <fileset dir="." includes="**/*.xml"/>
        </xmlvalidate>
    </target>

    <target name="alt">
        <taskdef resource="org/jetbrains/kotlin/ant/antlib.xml"
             classpath="${kotlin.ant.jar}"/>
        <mkdir dir="${build.dir}/alt-src"/>
        <copy todir="${build.dir}/alt-src">
            <fileset dir="src/jvmMain/kotlin" includes="**/*.kt"/>
        </copy>
        <replaceregexp match="org\\.vaskozlov\\.lab3" replace="org.vaskozlov.lab3.alt" flags="g">
            <fileset dir="${build.dir}/alt-src" includes="**/*.kt"/>
        </replaceregexp>
        <replaceregexp match="MainKt" replace="AltMainKt" flags="g">
            <fileset dir="${build.dir}/alt-src" includes="**/*.kt"/>
        </replaceregexp>
        <replaceregexp match="lab3" replace="lab3alt" flags="g">
            <fileset dir="${build.dir}/alt-src" includes="**/*.kt"/>
        </replaceregexp>
        <replaceregexp match="Database" replace="DatabaseAlt" flags="g">
            <fileset dir="${build.dir}/alt-src" includes="**/*.kt"/>
        </replaceregexp>
        <kotlinc src="${build.dir}/alt-src" output="${build.dir}/classes-alt" classpathref="compile.classpath"/>
        <jar destfile="${build.dir}/${ant.project.name}-alt.jar" basedir="${build.dir}/classes-alt">
            <manifest>
                <attribute name="Main-Class" value="org.vaskozlov.lab3.alt.AltMainKt"/>
            </manifest>
        </jar>
    </target>

    <target name="team">
        <!-- Создаём временную папку для работы -->
        <mkdir dir="${build.dir}/team"/>

        <!-- Клонируем репозиторий -->
        <exec executable="git">
            <arg line="clone --branch ant . ${build.dir}/team/repo"/>
        </exec>

        <exec dir="${build.dir}/team/repo" executable="chmod">
            <arg line="+x install-libs.sh"/>
        </exec>

        <exec dir="${build.dir}/team/repo" executable="./install-libs.sh"></exec>

        <exec dir="${build.dir}/team/repo" executable="npm">
            <arg line="install typescript"/>
        </exec>

        <!-- Обрабатываем первую ревизию HEAD~1 -->
        <mkdir dir="${build.dir}/team/out1"/>
        <exec dir="${build.dir}/team/repo" executable="git">
            <arg line="checkout HEAD~1"/>
        </exec>
        <exec dir="${build.dir}/team/repo" executable="ant">
            <arg value="-Dkotlin.home=kotlin-compiler/kotlinc"/>
            <arg value="jar"/>
        </exec>
        <copy file="${build.dir}/team/repo/build-ant/web-lab3.jar" tofile="${build.dir}/team/out1/web-lab3-head-1.jar"/>

        <!-- Обрабатываем вторую ревизию HEAD~2 -->
        <mkdir dir="${build.dir}/team/out2"/>
        <exec dir="${build.dir}/team/repo" executable="git">
            <arg line="checkout HEAD~2"/>
        </exec>
        <exec dir="${build.dir}/team/repo" executable="ant">
            <arg value="-Dkotlin.home=kotlin-compiler/kotlinc"/>
            <arg value="jar"/>
        </exec>
        <copy file="${build.dir}/team/repo/build-ant/web-lab3.jar" tofile="${build.dir}/team/out2/web-lab3-head-2.jar"/>

        <!-- Упаковка в zip -->
        <mkdir dir="${build.dir}/team/final"/>
        <zip destfile="${build.dir}/team/final/team-builds.zip">
            <fileset dir="${build.dir}/team/out1" includes="**/*.jar"/>
            <fileset dir="${build.dir}/team/out2" includes="**/*.jar"/>
        </zip>

        <echo message="Готово! Архив находится по пути: ${build.dir}/team/final/team-builds.zip"/>
    </target>


    <target name="env">
        <property file="env.properties"/>
        <java classname="org.vaskozlov.lab3.MainKt" fork="true">
            <classpath>
                <pathelement path="${build.dir}/classes"/>
                <path refid="compile.classpath"/>
            </classpath>
            <jvmarg line="${env.jvm.args}"/>
        </java>
    </target>

    <target name="report" depends="test">
        <mkdir dir="${build.dir}/report-archive"/>
        <zip destfile="${build.dir}/report-archive/test-report.zip">
            <fileset dir="${build.dir}/test-results"/>
        </zip>
        <exec executable="git">
            <arg line="add ${build.dir}/report-archive/test-report.zip"/>
        </exec>
        <exec executable="git">
            <arg line="commit --allow-empty -m 'Add JUnit test report archive'"/>
        </exec>
    </target>
    
</project>